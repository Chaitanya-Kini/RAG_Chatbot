# Copy this file to .env and fill in values you need to override.
# Do NOT commit your real .env with secrets into git.

# Example: Ollama server URL
OLLAMA_URL=http://localhost:11434

# Model name available in Ollama
DEFAULT_MODEL=llama3.2

# Embedding model (sentence-transformers or other compatible model name)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# How many context chunks to include (int)
MAX_CONTEXT_CHUNKS=5

# Optional override for storage dirs (absolute or relative paths)
#DATA_DIR=backend/data
#CHROMA_DIR=backend/chroma_db
